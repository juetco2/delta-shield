{
  "manifest_version": 3,
  "name": "DeltaShield - VirusTotal Threat Protection",
  "version": "1.0.0",
  "description": "Automated real-time VirusTotal threat scanning for visited sites and downloads with active threat interception.",
  "permissions": [
    "storage",
    "webNavigation",
    "downloads",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://www.virustotal.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeltaShield Security Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "intercept.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}